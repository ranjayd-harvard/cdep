# ---------------------------------------------------------------------------
# Publication Service environment configuration (local development defaults)
# Copy to .env and adjust as needed. Do not commit real credentials.
# ---------------------------------------------------------------------------

PUBLICATION_ENV=local

# --- Publication control-plane store (PostgreSQL, this service's own) -----
# Host port 5436: 5432 (local default), 5433 (data-exchange-service), and
# 5434 (data-lakehouse) are already taken on this machine.
PUBLICATION_DB_HOST=localhost
PUBLICATION_DB_PORT=5436
PUBLICATION_DB_NAME=publication
PUBLICATION_DB_USER=publication
PUBLICATION_DB_PASSWORD=publication

# --- Lakehouse Iceberg catalog (READ-ONLY) ---------------------------------
# Same Postgres-backed catalog data-lakehouse itself uses (its own compose
# publishes Postgres on host port 5434, MinIO on 9010/9011) -- this service
# never writes to Gold, it only reads it, so it connects to the lakehouse's
# existing infrastructure rather than owning its own copy of it.
PUBLICATION_LAKEHOUSE_CATALOG_NAME=local
PUBLICATION_LAKEHOUSE_CATALOG_URI=postgresql+psycopg2://lakehouse:lakehouse@localhost:5434/lakehouse
PUBLICATION_LAKEHOUSE_WAREHOUSE=s3://lakehouse-bronze/
PUBLICATION_LAKEHOUSE_S3_ENDPOINT=http://localhost:9010
PUBLICATION_LAKEHOUSE_S3_ACCESS_KEY=lakehouse
PUBLICATION_LAKEHOUSE_S3_SECRET_KEY=lakehouse123
PUBLICATION_LAKEHOUSE_S3_REGION=us-east-1

# Read-only access to data-lakehouse's own pipeline metadata (same Postgres
# instance/database as the catalog above, different schema: "lakehouse").
# Used to resolve GoldReady context from a bare --pipeline-run-id.
PUBLICATION_LAKEHOUSE_METADATA_DB_URL=postgresql+psycopg2://lakehouse:lakehouse@localhost:5434/lakehouse

# --- Exchange Service integration (outbound handoff) -----------------------
PUBLICATION_EXCHANGE_SERVICE_BASE_URL=http://localhost:8080
# Must match data-exchange-service's own INTERNAL_API_KEY.
PUBLICATION_EXCHANGE_SERVICE_API_KEY=dev-internal-key-change-me
# Only needed when this service runs inside Docker -- see the comment on
# `exchange_storage_relay_host` in src/publication/config/settings.py.
# Empty when running as a host process (e.g. via .venv directly).
PUBLICATION_EXCHANGE_STORAGE_RELAY_HOST=

# --- Local working storage --------------------------------------------------
PUBLICATION_WORK_DIR=./publication-work

# --- Contracts ---------------------------------------------------------------
PUBLICATION_CONTRACTS_DIR=./contracts/products

# --- Data Product Catalog (Phase 5) integration ------------------------------
# "local" (default): publishedSchema/sla/quality/publication settings come
# from PUBLICATION_CONTRACTS_DIR YAML only -- unchanged Phase 4 behavior.
# "catalog": overlay those fields from data-product-catalog-service's ACTIVE
# version contract; source.table/tenantScope/masking still come from the
# local YAML either way (see src/publication/contracts/loader.py).
PUBLICATION_CONTRACT_SOURCE=local
PUBLICATION_CATALOG_SERVICE_BASE_URL=http://localhost:8092
PUBLICATION_CATALOG_SERVICE_API_KEY=dev-internal-key-change-me

# --- This service's own internal HTTP API (superadmin portal integration) --
# Inbound auth checked against the `x-internal-api-key` header on every
# request to src/publication/api/ -- a separate key from
# PUBLICATION_EXCHANGE_SERVICE_API_KEY above (different services). Backs the
# "Publish Gold Product" panel at /admin/lakehouse/pipelines in the portal.
PUBLICATION_INTERNAL_API_KEY=dev-internal-key-change-me-publication
PUBLICATION_API_PORT=8000
