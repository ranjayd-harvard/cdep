{
  "name": "data-product-api-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 8 Data Product API Delivery Layer. Authenticated, entitled, tenant-isolated, cursor-paginated customer reads of the API Serving Store -- Catalog/Entitlement/Subscription remain owned by their own services.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/scripts/start.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "export-openapi": "tsx --env-file=.env scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^6.1.0",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
