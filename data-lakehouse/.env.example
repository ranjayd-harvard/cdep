# ---------------------------------------------------------------------------
# Lakehouse environment configuration (local development defaults)
# Copy to .env and adjust as needed. Do not commit real credentials.
# ---------------------------------------------------------------------------

LAKEHOUSE_ENV=local

# --- Ingestion metadata store (PostgreSQL) ---------------------------------
LAKEHOUSE_METADATA_DB_HOST=localhost
# Host port 5434 (not 5432/5433): 5433 is already used by
# data-exchange-service's own Postgres on this machine.
LAKEHOUSE_METADATA_DB_PORT=5434
LAKEHOUSE_METADATA_DB_NAME=lakehouse
LAKEHOUSE_METADATA_DB_USER=lakehouse
LAKEHOUSE_METADATA_DB_PASSWORD=lakehouse
LAKEHOUSE_METADATA_DB_SCHEMA=lakehouse

# --- Iceberg catalog (also PostgreSQL-backed, separate schema) ------------
LAKEHOUSE_CATALOG_NAME=local
LAKEHOUSE_CATALOG_URI=postgresql+psycopg2://lakehouse:lakehouse@localhost:5434/lakehouse
LAKEHOUSE_CATALOG_SCHEMA=iceberg_catalog
LAKEHOUSE_WAREHOUSE=s3://lakehouse-bronze/

# --- Object storage (MinIO, S3-compatible) ---------------------------------
# Host ports 9010/9011 (not 9000/9001): those are already used by
# data-exchange-service's own MinIO on this machine.
LAKEHOUSE_STORAGE_KIND=s3
LAKEHOUSE_S3_ENDPOINT=http://localhost:9010
LAKEHOUSE_S3_ACCESS_KEY=lakehouse
LAKEHOUSE_S3_SECRET_KEY=lakehouse123
LAKEHOUSE_S3_REGION=us-east-1

LAKEHOUSE_BUCKET_EXCHANGE_INBOUND=exchange-inbound
LAKEHOUSE_BUCKET_BRONZE=lakehouse-bronze
LAKEHOUSE_BUCKET_SILVER=lakehouse-silver
LAKEHOUSE_BUCKET_GOLD=lakehouse-gold

# --- Exchange Service integration ------------------------------------------
# "mock" uses local fixture manifests/files under samples/, "http" calls a
# real data-exchange-service instance (its internal manifest endpoint,
# gated by INTERNAL_API_KEY -- must match that service's own value).
LAKEHOUSE_EXCHANGE_CLIENT=mock
LAKEHOUSE_EXCHANGE_SERVICE_BASE_URL=http://localhost:8080
LAKEHOUSE_EXCHANGE_SERVICE_API_KEY=dev-internal-key-change-me

# Only used when LAKEHOUSE_EXCHANGE_CLIENT=http: a real
# data-exchange-service instance's *own* object storage (where the
# customer's uploaded file actually lives), separate from this lakehouse's
# own MinIO/S3 above -- see README "Real E2E via the portal UI".
LAKEHOUSE_EXCHANGE_S3_ENDPOINT=http://localhost:9000
LAKEHOUSE_EXCHANGE_S3_ACCESS_KEY=minioadmin
LAKEHOUSE_EXCHANGE_S3_SECRET_KEY=minioadmin
LAKEHOUSE_EXCHANGE_S3_REGION=us-east-1

# --- Schema evolution -------------------------------------------------------
LAKEHOUSE_SCHEMA_MODE=PERMISSIVE

# --- This service's own internal HTTP API (superadmin portal integration) --
# Inbound auth checked against the `x-internal-api-key` header on every
# request to src/lakehouse/api/ -- a separate key from
# LAKEHOUSE_EXCHANGE_SERVICE_API_KEY above (different services).
LAKEHOUSE_INTERNAL_API_KEY=dev-internal-key-change-me-lakehouse
LAKEHOUSE_API_PORT=8000
