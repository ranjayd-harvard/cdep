NODE_ENV=development

PORT=8080

DATABASE_URL=postgresql://exchange:exchange@postgres:5432/exchange

OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Endpoint used only when *signing* URLs handed to browsers/external clients.
# Inside docker-compose the service reaches MinIO at "minio:9000" but a
# browser on the host machine can only reach it at "localhost:9000" - so
# signed URLs must be generated with this externally-reachable endpoint.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1

OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

INBOUND_BUCKET=exchange-inbound
OUTBOUND_BUCKET=exchange-outbound

SIGNED_UPLOAD_URL_TTL_SECONDS=900
SIGNED_DOWNLOAD_URL_TTL_SECONDS=300

MAX_UPLOAD_SIZE_BYTES=5368709120

AUTH_MODE=development

INTERNAL_API_KEY=dev-internal-key-change-me

LOG_LEVEL=info

# Outbound calls this service makes to data-lakehouse and
# data-publication-service to run the real Bronze->Silver->Gold->Publish
# chain for queued pipeline jobs (see src/pipeline-worker/). Leave either
# unset to skip starting the worker -- enqueued jobs (from
# POST /internal/v1/pipeline-jobs) then simply stay PENDING. Keys must
# match each target service's own LAKEHOUSE_INTERNAL_API_KEY /
# PUBLICATION_INTERNAL_API_KEY (see their own .env.example files).
LAKEHOUSE_SERVICE_URL=
LAKEHOUSE_SERVICE_INTERNAL_API_KEY=
PUBLICATION_SERVICE_URL=
PUBLICATION_SERVICE_INTERNAL_API_KEY=
PIPELINE_WORKER_POLL_INTERVAL_MS=15000

# Only used by `npm run sync:cdep` (scripts/sync-cdep-catalog.ts) — not
# read by the running service itself. Points at cdep's own MongoDB so
# that script can mirror cdep's real organizations/tenants/datasets/
# entitlements in here. Matches cdep's own MONGODB_URI (see cdep/.env).
# See docs/exchange-service-integration.md § "Keeping catalogs in sync".
#CDEP_MONGODB_URI=mongodb://<user>:<pass>@localhost:27025/portal?authSource=admin
#CDEP_MONGODB_DATABASE=portal
