{
  "name": "data-exchange-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Exchange control plane and secure storage gateway for the Customer Data Exchange Platform.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/scripts/start.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file=.env scripts/run-migrations.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "sync:cdep": "tsx --env-file=.env scripts/sync-cdep-catalog.ts",
    "buckets:init": "tsx --env-file=.env scripts/init-buckets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^6.1.0",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "mongodb": "^7.6.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
