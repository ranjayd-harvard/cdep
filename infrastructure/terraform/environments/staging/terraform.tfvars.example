# Copy to terraform.tfvars (gitignored) and fill in real values.

project_name   = "dpp"
environment    = "staging"
aws_region     = "us-east-1"
aws_account_id = "123456789012"

vpc_cidr = "10.20.0.0/16"
availability_zones = [
  "us-east-1a",
  "us-east-1b",
]
public_subnet_cidrs       = ["10.20.0.0/24", "10.20.1.0/24"]
private_app_subnet_cidrs  = ["10.20.10.0/24", "10.20.11.0/24"]
private_data_subnet_cidrs = ["10.20.20.0/24", "10.20.21.0/24"]

enable_nat_gateway = true
single_nat_gateway = true # staging tolerates a single shared NAT; production does not

domain_name                  = "staging.dataproducts.example.com"
enable_route53_records       = true
create_route53_hosted_zone   = false # staging shares the parent domain's existing zone
route53_hosted_zone_id       = "Z0000000000000000EXMP"
acm_certificate_arn_override = null # let this stack manage ACM via Route 53 DNS validation

enable_waf        = true
enable_cloudfront = false
enable_emr        = true

ecs_cpu                    = 512
ecs_memory                 = 1024
ecs_public_desired_count   = 2
ecs_internal_desired_count = 1
ecs_max_capacity           = 4

rds_instance_class       = "db.t4g.small"
rds_allocated_storage     = 50
rds_multi_az              = false
rds_deletion_protection   = true
rds_skip_final_snapshot   = false
rds_backup_retention_days = 14

retention_days = 30

container_images = {
  "customer-portal"            = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-customer-portal:REPLACE-ME"
  "exchange-service"           = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-exchange-service:REPLACE-ME"
  "lakehouse-service"          = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-lakehouse-service:REPLACE-ME"
  "catalog-service"            = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-catalog-service:REPLACE-ME"
  "subscription-service"       = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-subscription-service:REPLACE-ME"
  "scheduler-service"          = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-scheduler-service:REPLACE-ME"
  "publication-service"        = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-publication-service:REPLACE-ME"
  "product-api-service"        = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-product-api-service:REPLACE-ME"
  "observability-service"      = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-observability-service:REPLACE-ME"
  "serving-projection-service" = "<account-id>.dkr.ecr.us-east-1.amazonaws.com/dpp-staging-serving-projection-service:REPLACE-ME"
}

tags = {
  Owner = "platform-team"
}
